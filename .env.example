# Plain-English layer (P3). Pick ONE. With neither, the app uses rule-based descriptions.

# Production / any provider: Vercel AI Gateway. NARRATE_MODEL is a "provider/model" string.
AI_GATEWAY_API_KEY=
# NARRATE_MODEL=anthropic/claude-sonnet-5-5

# Development with a free Gemini key. PUBLIC REPOS ONLY: free-tier prompts may be used by Google to improve its products.
GOOGLE_GENERATIVE_AI_API_KEY=
# NARRATE_GOOGLE_MODEL=gemini-2.5-flash

# Opt in to sending the first 1,500 characters of README.md to the model. Default: metadata only.
# NARRATE_INCLUDE_README=1

# --- Live health (P4) ---
# Optional. Raises GitHub's rate limit from 60/hour to 5,000/hour for PUBLIC repos. A fine-grained token with no permissions is enough.
# GITHUB_TOKEN=
# Required to receive webhooks (instant updates). Without it, live views still refresh every ~20s by polling.
# GITHUB_WEBHOOK_SECRET=
# GitHub App credentials (see docs/HEALTH.md). Enables reading repos the App is installed on.
# GITHUB_APP_ID=
# GITHUB_APP_PRIVATE_KEY=   # PEM; newlines may be written as \n
# GitHub Enterprise Server (or a mock for tests):
# GITHUB_API_URL=https://api.github.com

# --- Connectors & replay (P6). See docs/CONNECTORS.md ---
# Connector data is served ONLY for repos listed here (comma separated). Until sign-in exists, tokens below belong to
# you and must not be shown to arbitrary visitors who paste a repo.
# CONNECTOR_REPOS=owner/name,owner/other

# OpenTelemetry traces (OTLP/HTTP JSON) pushed to /api/otlp/v1/traces
# OTLP_INGEST_KEY=

# Sentry (error volume + top issues per project)
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_BASE_URL=https://sentry.io

# Vercel (deployments of one project -> deploy health on the matching environment)
# VERCEL_TOKEN=
# VERCEL_PROJECT_ID=
# VERCEL_TEAM_ID=

# Where rollups and per-commit maps are kept. Default: files in .data/ (dev). Use "memory" on serverless or in tests.
# TWIN_PERSIST=memory

# --- Sign-in & private repos (P4b). See docs/AUTH.md ---
# Sealed-cookie key for sessions. 32+ random characters: openssl rand -hex 32. Rotating it signs everyone out.
# SESSION_SECRET=
# From your GitHub App's settings page ("Client ID" and a generated client secret):
# GITHUB_APP_CLIENT_ID=
# GITHUB_APP_CLIENT_SECRET=
# The App's URL slug, for the "Install the GitHub App" button: github.com/apps/<slug>
# GITHUB_APP_SLUG=
# Public origin of this app (OAuth redirect URI = APP_URL/api/auth/callback). Defaults to the request's host.
# APP_URL=https://your-host
# GitHub Enterprise Server / test doubles:
# GITHUB_WEB_URL=https://github.com

# --- Persistence (P7) ---
# Neon Postgres, provisioned through the Vercel Marketplace (`vercel integration add neon`). When set, snapshots,
# runtime buckets and confirmed mappings are stored there. Unset: files in .data/ locally, memory on Vercel.
# TWIN_PERSIST=memory|file forces an adapter. Tests run against Postgres when TEST_DATABASE_URL is set.
# DATABASE_URL=
